# ─────────────────────────────────────────────────────────────────────────────
# Optional. Turns on the model layer: it classifies the page type before any
# criterion is judged, confirms the criteria whose verdict depends on reading
# wording or intent (error copy, button labels, which fields a task needs), and
# writes the summary. Without it the audit still runs — those criteria are
# reported as needing a reviewer rather than being guessed at, and the findings
# keep the catalog's own wording.
#   Get one: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Optional. Only matters when no browser is available: a rendering reader for
# pages whose content is assembled in the browser. Without it, and without a
# browser, a single-page app reads as an empty shell.
#   Get one: https://jina.ai/reader (free tier available)
JINA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# The browser the audit measures with. Left unset, it looks for an installed
# Chrome, then Edge, then Playwright's own download — which is what the
# Dockerfile installs. Point this at a binary to override the search.
PLAYWRIGHT_CHROMIUM_PATH=

# Set to `off` to skip the browser entirely. The audit then reports every
# criterion that needs layout, colour, focus or timings as not assessed, with
# the reason — it never passes a check that did not run.
ZAUDIT_CAPTURE=

# ─────────────────────────────────────────────────────────────────────────────
# Optional, and only relevant on a serverless host (Vercel): where finished
# reports are kept so a /report/<id> link still resolves on a different
# instance, or tomorrow. Create a Blob store in the Vercel dashboard and this
# is set for you. Left unset, reports live in the process that ran the audit —
# fine for one server, and a shared link then only works while it is warm.
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# ACCOUNTS AND CREDITS
#
# All four of these together switch on sign-in, credits and buying. Leave them
# unset and the app runs exactly as it did before accounts existed: no sign-in,
# no metering, audits for whoever asks. That is the right setting for a demo.

# The database. Neon, because the credit ledger needs a transaction and the
# WebSocket driver has them. Create one from the Vercel dashboard (Storage →
# Neon) and this is filled in for you.
DATABASE_URL=

# Signs the session cookie. Generate one: `npx auth secret`, or
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
AUTH_SECRET=

# Sends the sign-in links. https://resend.com → API Keys. The domain in
# AUTH_EMAIL_FROM has to be one you have verified with them, or the mail is
# refused.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Zaudit <hello@yourdomain.com>"

# Selling credits. Both are needed: the secret key to start a checkout, and the
# webhook secret to trust what comes back. The webhook endpoint is
# /api/billing/webhook, and it must be subscribed to checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
